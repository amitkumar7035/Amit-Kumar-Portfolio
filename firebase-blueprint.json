{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Portfolio project record showcasing web and software development work",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 300 },
        "longDescription": { "type": "string", "maxLength": 3000 },
        "problem": { "type": "string", "maxLength": 1500 },
        "solution": { "type": "string", "maxLength": 1500 },
        "challenges": { "type": "string", "maxLength": 1500 },
        "image": { "type": "string", "maxLength": 500 },
        "technologies": { "type": "array" },
        "features": { "type": "array" },
        "category": { "type": "string", "maxLength": 50 },
        "githubUrl": { "type": "string", "maxLength": 500 },
        "liveUrl": { "type": "string", "maxLength": 500 },
        "featured": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "description", "category"]
    },
    "Skill": {
      "title": "Skill",
      "description": "Skill item categorized into Frontend, Programming, Tools, or Currently Learning",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 60 },
        "category": { "type": "string", "maxLength": 50 },
        "level": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 200 },
        "icon": { "type": "string", "maxLength": 50 },
        "order": { "type": "number" }
      },
      "required": ["name", "category", "level"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Certification or credential item",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "issuer": { "type": "string", "maxLength": 100 },
        "issueDate": { "type": "string", "maxLength": 50 },
        "credentialUrl": { "type": "string", "maxLength": 500 },
        "previewUrl": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "issuer"]
    },
    "Education": {
      "title": "Education",
      "description": "Education timeline entry",
      "type": "object",
      "properties": {
        "degree": { "type": "string", "maxLength": 120 },
        "field": { "type": "string", "maxLength": 120 },
        "institution": { "type": "string", "maxLength": 150 },
        "duration": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "order": { "type": "number" }
      },
      "required": ["degree", "institution"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Message submitted via contact form",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "subject": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 3000 },
        "status": { "type": "string", "enum": ["NEW", "READ", "REPLIED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "subject", "message", "status"]
    },
    "AdminProfile": {
      "title": "AdminProfile",
      "description": "Administrator account metadata",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "maxLength": 30 },
        "displayName": { "type": "string", "maxLength": 100 }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of developer portfolio projects"
    },
    "/skills/{skillId}": {
      "schema": "Skill",
      "description": "Developer skills and learning roadmap"
    },
    "/certificates/{certificateId}": {
      "schema": "Certificate",
      "description": "Certificates and credentials"
    },
    "/education/{educationId}": {
      "schema": "Education",
      "description": "Education timeline items"
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Inbound contact submissions from recruiters, clients, and visitors"
    },
    "/admins/{adminUid}": {
      "schema": "AdminProfile",
      "description": "Registered administrators permitted to manage portfolio data"
    }
  }
}
