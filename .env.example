# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Database connection string (PostgreSQL / SQLite)
DATABASE_URL="file:./prisma/dev.db"

# AUTH_SECRET: Cryptographic secret key used to sign and verify sessions
AUTH_SECRET="your-super-secret-auth-key-change-in-production"

# ADMIN_EMAIL: Primary portfolio administrator email
ADMIN_EMAIL="amitkumar678793@gmail.com"

# EMAIL_SERVER & EMAIL_FROM: For outgoing password reset emails (optional)
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="noreply@amitkumar.dev"
